# === 系統配置 ===
NODE_ENV=development

# === 資料庫配置 (PostgreSQL) ===
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=chatpassword
POSTGRES_DB=chatdb
DATABASE_URL=postgresql://chatuser:chatpassword@db:5432/chatdb

# === Redis 配置 ===
# 這個 URL 是在 backend 容器內解析的，所以主機名是 compose 服務名 `redis`，
# 不是 `localhost`（與 `db:5432` 對 `localhost:5435` 是同一個陷阱）。開發堆疊
# 另外把 Redis 發布在主機的 127.0.0.1:6385，供 redis-cli 等主機端工具使用。
#
# 覆寫本變數只會改變 backend 連到哪裡，不會讓 compose 停掉本機的 redis 容器；
# 指向託管 Redis 時通常要改用 `rediss://`。
#
# 留空是支援的部署方式，不是設定錯誤：Redis 只存衍生狀態（presence lease、
# typing TTL、跨節點廣播），沒有它後端一樣提供所有 REST 路由，只是即時通訊退
# 回單節點。後端啟動時也不會因為 Redis 連不上而失敗。
#
# 要停用請把值留空（`REDIS_URL=`），不要把整行刪掉：兩個 compose 檔寫的都是
# `${REDIS_URL-redis://redis:6379}`，變數未設定時仍會補上預設值，只有空字串
# 會原樣傳進容器，讓後端判定成沒有 Redis。
REDIS_URL=redis://redis:6379

# === 後端配置 ===
PORT=4000
JWT_SECRET=dev_secret_key
JWT_EXPIRES_IN=15m
# 後端結構化日誌等級：fatal / error / warn / info / debug / trace / silent。
# 留空即為 info（測試執行時自動為 silent）。無法辨識的值會退回 info，不會讓
# 後端在啟動時因為一個拼錯的等級而崩潰。
# LOG_LEVEL=info
# 關閉速率限制（開發 / 測試用，正式環境請移除）
RATE_LIMIT_DISABLED=true
# 後端前方有幾層「我們自己維運」的反向代理。限流會取 X-Forwarded-For 由右
# 數來第 n 段作為來源 IP：右側是各層代理自己寫入的，左側則可能是用戶端自行
# 帶入的內容，因此取左端等同讓用戶端自選限流桶。
#
# 開發堆疊為瀏覽器直連，前方沒有代理，所以此處留空（等同 0，只採用實際連線
# 位址）。正式堆疊（cloudflared tunnel）需要 1，該值已直接寫死在
# docker-compose.prod.yml 中 —— Compose 會讀取本檔複製而成的 .env 進行插值，
# 若在此設值會連帶覆寫正式環境的設定（issue #413 記錄過這個陷阱）。
#
# 僅在本機開發堆疊前方另外架設代理（如 Tailscale Serve、本機 nginx）時才需
# 設定；驗證方式見 docs/DEVELOPMENT.md。
# TRUST_PROXY_HOPS=
#
# 舊的布林開關，保留相容：未設定 TRUST_PROXY_HOPS 時 true 等同 1 層。新設定
# 請改用 TRUST_PROXY_HOPS。
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3005
# Realtime session and ephemeral-indication limits
MAX_SESSIONS_PER_USER=5
PRESENCE_GRACE_MS=3000
# Presence lease 在 Redis 中沒有被續約時能存活多久（毫秒）。它決定「某個
# instance 當掉後，它的使用者最多會被誤顯示成在線多久」—— 行程已死就沒有人
# 能把 lease 還回去，只剩過期能清掉它。後端每 1/3 個 TTL 續約一次，因此連續
# 掉兩次續約仍不會讓在線中的連線被誤判離線。REDIS_URL 留空時本變數無作用。
PRESENCE_TTL_MS=30000
TYPING_TTL_MS=3000

# 本行程在跨 instance 共享狀態中的識別名稱。Presence lease 以 instance 為單位
# 持有（每個 user 的 hash 中一個 instance 一個欄位），所以這就是其他 instance
# 看到的身分。留空（或整行註解掉）時後端會在啟動時自行產生一個 UUID。
#
# 若編排器本來就有穩定的 per-replica 名稱（StatefulSet 序號、Compose service
# instance），設定它是有價值的：重啟後沿用同一個名稱的行程會直接覆寫自己先前
# 的 lease，而不是多留一個要等 TTL 過期的孤兒。
# INSTANCE_ID=

# 這個 deployment 的 realtime cluster 名稱。留空時跨 instance 廣播使用
# `near-chat-ws` 這個 Redis channel，對「一套 stack 搭配自己的 redis 服務」的
# 標準部署而言是正確的預設值。
#
# 只有在多個 deployment 共用同一台 Redis 時才需要設定，而且每個 deployment 要
# 給不同的值。Redis 的 pub/sub **不受 logical database 隔離**：在 `/1` 上
# SUBSCRIBE 會收到 `/0` 上 PUBLISH 的訊息，因此光靠 `REDIS_URL` 換 `/0`、`/1`
# 並不能把兩套環境分開，它們會被併成同一個 Socket.IO cluster。又因為
# backend/src/models/seed.ts 給每個 seed 過的環境相同的 user 與 room ID，
# 一邊的房間事件、成員變更與強制斷線會真的送到另一邊的連線上。
# REALTIME_CLUSTER_ID=

# --- 後端可調參數（預設值即為下列數值，通常不需修改）---
# 這些變數由 backend/src/config/env.ts 讀取，該模組是後端環境變數的權威清單。
#
# 注意：兩個 docker-compose 檔案目前都沒有把下列變數傳入 backend 容器，因此在
# 這裡取消註解「不會」對 Docker 堆疊生效 —— 需要同時加進對應 compose 檔的
# backend `environment:` 區塊。直接以 `bun src/index.ts` 執行時則會立即生效。
# 無法解析的值會在啟動時以警告列出並改用預設值。
#
# 全域限流：每個視窗長度（毫秒）與該視窗內的請求上限。
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=1000
#
# /api/v1/auth/* 的獨立限流（僅計算失敗的請求）。
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=10
#
# 握手保留 session 名額的存活時間（毫秒）。連線在 Socket.IO middleware 之後、
# connection 事件之前斷掉時，該名額靠這個逾時歸還。
# SESSION_RESERVATION_TTL_MS=10000
#
# refresh token 存活天數，以及 refresh cookie 的 Max-Age（毫秒）。
# 後者未設定時預設等同前者。
# JWT_REFRESH_EXPIRES_IN_DAYS=14
# REFRESH_COOKIE_MAX_AGE_MS=1209600000

# 測試資料庫連線字串。僅在 NODE_ENV=test 時優先於 DATABASE_URL；請勿在此設定，
# 改用 backend/.env.test（範本見 backend/.env.test.example）。
# DATABASE_URL_TEST=

# === 前端配置 ===
# Next.js 前端呼叫後端位址
# Browser-facing backend URL. Docker Compose exposes backend host port 4005.
NEXT_PUBLIC_API_URL=http://localhost:4005
# 允許進行開發連線的來源網域（例如使用 Tailscale 連線時填入：raynb.tail5fc9fe.ts.net,100.73.193.72）
ALLOWED_DEV_ORIGINS=
# 訊息最大字數限制（預設為 1000）
NEXT_PUBLIC_MAX_MESSAGE_LENGTH=1000

# Docker Compose upload storage source
# Default: Docker named volume `app_uploads`
# Example host path on Windows: C:/chat-uploads
# Example host path on macOS/Linux: /Users/you/chat-uploads
UPLOADS_MOUNT_SOURCE=app_uploads

# Attachment upload configuration
# By default attachment type restriction is disabled, so uploads stay type-open.
ATTACHMENT_TYPE_RESTRICTION_ENABLED=false
# Built-in reference whitelist. These values only take effect when
# ATTACHMENT_TYPE_RESTRICTION_ENABLED=true, and can be overridden per deployment.
ATTACHMENT_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/zip,text/plain
ATTACHMENT_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf,.zip,.txt
# 10 MB default
ATTACHMENT_MAX_BYTES=10485760
# === 部署配置 ===
# Cloudflare Tunnel Token
TUNNEL_TOKEN=
