# Bun is both the package manager and the runtime, installing from the single
# root bun.lock. Build context is the repo root.

# Stage 1: Install and typecheck against the full (dev) dependency tree
FROM oven/bun:1.3-slim AS builder
ENV CI=true
WORKDIR /workspace

COPY package.json bun.lock ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY shared/ ./shared/

RUN bun install --frozen-lockfile --filter './backend' --filter '.'

COPY tsconfig.base.json ./
COPY backend/tsconfig.json ./backend/
COPY backend/src ./backend/src
COPY backend/tests ./backend/tests

WORKDIR /workspace/backend
RUN bun run lint

# Stage 2: Production runner with production-only dependencies
FROM oven/bun:1.3-slim AS runner
ENV CI=true
ENV NODE_ENV=production

RUN apt-get update -y && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# uploads/ is resolved from the backend's cwd (see src/utils/uploads.ts).
RUN mkdir -p /workspace/backend/uploads/attachments /workspace/backend/uploads/avatars
RUN chown -R bun:bun /workspace

USER bun

COPY --chown=bun:bun package.json bun.lock ./
COPY --chown=bun:bun backend/package.json ./backend/
COPY --chown=bun:bun frontend/package.json ./frontend/
COPY --chown=bun:bun shared/ ./shared/

RUN bun install --frozen-lockfile --production --filter './backend' --filter '.'

# `@shared/*` resolves relative to tsconfig.base.json, so it must sit beside
# backend/ and shared/.
COPY --chown=bun:bun tsconfig.base.json ./
COPY --chown=bun:bun backend/tsconfig.json ./backend/
COPY --chown=bun:bun backend/src ./backend/src
COPY --chown=bun:bun backend/migrations ./backend/migrations

WORKDIR /workspace/backend

EXPOSE 4000

CMD ["sh", "-c", "bun run migrate:up && bun src/index.ts"]
