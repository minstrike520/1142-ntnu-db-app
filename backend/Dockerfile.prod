# Stage 1: Install + typecheck against the pnpm workspace.
#
# Previously this stage copied the ROOT pnpm-lock.yaml and then ran
# `bun install`, which ignores pnpm lockfiles entirely — the image was
# effectively built from unpinned dependency resolution.
FROM oven/bun:1.4.0-slim AS builder
ENV CI=true

# pnpm 11 requires `node:sqlite`, which bun does not implement, so pnpm cannot
# execute on a bun-only image. Graft the node toolchain in rather than switching
# the base image — bun stays the runtime. (Approach from #419.)
#
# The package manager is now the ONLY reason node is here, and only in this
# builder stage — the runner stage below has always been bun-only. #421 removed
# the other reason by replacing `node-pg-migrate` with a `Bun.SQL` runner, so
# the migration step the runner executes at startup no longer needs node. This
# COPY can go when the package manager does — see #416.
COPY --from=node:22-slim /usr/local/ /usr/local/
RUN corepack enable pnpm && corepack prepare pnpm@11.15.0 --activate

WORKDIR /workspace

# All workspace manifests are required: `--frozen-lockfile` validates the
# lockfile against every importer it contains.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

RUN pnpm install --frozen-lockfile --filter near-chat-backend...

COPY tsconfig.base.json ./
COPY shared/ ./shared/
COPY backend/tsconfig.json ./backend/
COPY backend/src ./backend/src

WORKDIR /workspace/backend
# `pnpm exec`, not `bun exec`: the binary lives in pnpm's
# node_modules/.bin symlink farm, which bun does not add to PATH.
RUN pnpm exec tsc --noEmit

# Flatten the symlinked pnpm store into a standalone node_modules. Copying a
# pnpm tree across stages directly would yield dangling symlinks, because the
# real packages live in /workspace/node_modules/.pnpm outside the copied path.
WORKDIR /workspace
RUN pnpm deploy --filter near-chat-backend --prod --legacy /deploy

# Stage 2: Production runner.
#
# Runtime is bun only — no node, no pnpm, no install step, because stage 1
# already produced a self-contained node_modules. Note the layout deliberately
# keeps /shared and /tsconfig.base.json at the filesystem root: backend/
# tsconfig.json sets "rootDir": "..", so the app resolves them one level above
# its own directory. This is not a workspace and must not be reshaped into one.
FROM oven/bun:1.4.0-slim AS runner
ENV CI=true
WORKDIR /app

RUN mkdir -p /app/uploads/attachments /app/uploads/avatars \
 && chown -R bun:bun /app

USER bun

COPY --from=builder --chown=bun:bun /deploy/node_modules ./node_modules
COPY --chown=bun:bun backend/package.json ./

COPY --chown=bun:bun backend/src ./src
COPY --chown=bun:bun backend/migrations ./migrations
COPY --chown=bun:bun shared /shared
COPY --chown=bun:bun tsconfig.base.json /tsconfig.base.json
COPY --chown=bun:bun backend/tsconfig.json ./tsconfig.json

EXPOSE 4000
ENV NODE_ENV=production

# `exec` is load-bearing, not style. `/bin/sh` here is dash, and the `&&` stops
# it from exec-optimising the tail, so without `exec` dash stays PID 1 and runs
# bun as a child. dash never forwards signals, and the kernel discards signals
# with a default disposition sent to PID 1 — so `docker stop` was a no-op: the
# container ignored SIGTERM, ran until the grace period expired and died on
# SIGKILL (exit 137), with src/index.ts's SIGTERM drain never entering. `exec`
# replaces dash with bun, so the application is PID 1 and receives the signal
# itself (issue #586).
#
# SIGTERM is still ignored while `migrate:up` runs, because dash is PID 1 for
# that window. That is safe and deliberately not worked around: migrations run
# in one transaction under a session-scoped advisory lock (src/models/migrate.ts),
# so a SIGKILL mid-migration rolls back and frees the lock with nothing half
# applied.
CMD ["sh", "-c", "bun run migrate:up && exec bun src/index.ts"]
