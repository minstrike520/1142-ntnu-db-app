{
  "name": "near-chat-backend",
  "version": "2.1.1",
  "description": "Bun + Hono backend API for Near Chat",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "bun src/index.ts",
    "migrate:up": "bun src/models/migrate.ts up",
    "migrate:down": "bun src/models/migrate.ts down",
    "migrate:create": "bun src/models/migrate.ts create",
    "test": "bun test tests/unit && bun test tests/integration && bun test tests/e2e",
    "db:seed": "bun src/models/seed.ts",
    "test:unit": "bun test tests/unit",
    "test:coverage": "bun test tests/unit --coverage",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "test:e2e:local": "pnpm run test:db:up && bun test tests/e2e",
    "test:db:up": "docker compose -f ../docker-compose.yml up -d --wait db-test && pnpm run migrate:test",
    "test:db:down": "docker compose -f ../docker-compose.yml stop db-test && docker compose -f ../docker-compose.yml rm -f db-test",
    "migrate:test": "bun src/models/migrate.ts up --database-url=postgresql://postgres:***@localhost:5436/ntnu_test",
    "lint": "eslint src && tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@socket.io/bun-engine": "^0.1.1",
    "hono": "^4.13.4",
    "hono-rate-limiter": "^0.5.3",
    "pino": "^10.3.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "bun-types": "^1.4.0",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^6.0.3"
  }
}
