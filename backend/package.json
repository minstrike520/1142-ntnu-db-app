{
  "name": "near-chat-backend",
  "version": "2.1.1",
  "description": "Bun + Hono backend API for Near Chat",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "bun src/index.ts",
    "migrate:up": "bun src/models/migrate.ts up",
    "migrate:down": "bun src/models/migrate.ts down",
    "migrate:create": "bun src/models/migrate.ts create",
    "test": "bun test tests/unit && bun test tests/integration && bun test tests/e2e",
    "db:seed": "bun src/models/seed.ts",
    "test:unit": "bun test tests/unit",
    "test:coverage": "bun test tests/unit --coverage",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun test tests/e2e",
    "test:e2e:local": "pnpm run test:db:up && bun test tests/e2e",
    "test:db:up": "docker compose -f ../docker-compose.test.yml up -d --wait && pnpm run migrate:test",
    "test:db:down": "docker compose -f ../docker-compose.test.yml down",
    "migrate:test": "DATABASE_URL=postgresql://postgres:postgres@localhost:5436/ntnu_test bun src/models/migrate.ts up",
    "lint": "eslint src && tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@socket.io/bun-engine": "^0.1.1",
    "hono": "^4.13.2",
    "hono-rate-limiter": "^0.5.3",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "bun-types": "^1.3.14",
    "eslint": "^10.8.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3"
  }
}
