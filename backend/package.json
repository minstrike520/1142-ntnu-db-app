{
  "name": "near-chat-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc",
    "start": "bun src/index.ts",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "test": "bun scripts/run-tests.ts tests",
    "db:seed": "tsx src/models/seed.ts",
    "test:unit": "bun scripts/run-tests.ts tests/unit",
    "test:coverage": "bun test --coverage",
    "test:integration": "bun scripts/run-tests.ts tests/integration",
    "test:e2e": "bun scripts/run-tests.ts tests/e2e",
    "test:e2e:local": "pnpm run test:db:up && pnpm run migrate:test && bun scripts/run-tests.ts tests/e2e",
    "test:db:up": "docker compose -f ../docker-compose.test.yml up -d --wait && pnpm run migrate:test",
    "test:db:down": "docker compose -f ../docker-compose.test.yml down",
    "migrate:test": "DATABASE_URL=postgresql://postgres:postgres@localhost:5436/ntnu_test node-pg-migrate up"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@hono/zod-validator": "^0.9.0",
    "config": "^3.3.12",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^12.0.1",
    "hono": "^4.12.30",
    "hono-rate-limiter": "^0.5.3",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "bun-types": "^1.2.23",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
