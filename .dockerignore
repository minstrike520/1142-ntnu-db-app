# All four image builds (dev + prod, backend + frontend) use the repository
# root as their build context, so this is the only .dockerignore that applies.
# The former backend/.dockerignore and frontend/.dockerignore became dead files
# once the contexts moved to the root, and have been folded in here.

# dependencies & build output
**/node_modules
**/.next
**/dist
**/coverage
**/.pnpm-store
.pnpm-store

# vcs
**/.git
.git
.gitignore

# env files — keep the committed examples so the images still document setup.
# Broadened from the old root list to cover per-package env files (e.g.
# backend/.env.test), which the per-package ignore files used to exclude.
**/.env
**/.env.*
!**/.env.example
!**/.env.test.example

# user uploads (runtime data, supplied by a volume)
**/uploads

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
