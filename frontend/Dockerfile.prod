# Bun is both the package manager and the runtime, installing from the single
# root bun.lock. Build context is the repo root.

# Stage 1: Install and build
FROM oven/bun:1.3-slim AS builder
ENV CI=true
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace

COPY package.json bun.lock ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
COPY shared/ ./shared/

RUN bun install --frozen-lockfile --filter './frontend' --filter '.'

COPY tsconfig.base.json ./
COPY frontend/ ./frontend/

# Pass API URL at build time for Next.js to inline into client bundles
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

WORKDIR /workspace/frontend
RUN bun run build

# Stage 2: Runner
FROM oven/bun:1.3-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN chown -R bun:bun /app
USER bun

# In a workspace, Next emits the standalone tree rooted at the workspace, so the
# server lands at ./frontend/server.js with traced deps in ./node_modules —
# not at the top level as it does for a single-package build.
COPY --from=builder --chown=bun:bun /workspace/frontend/.next/standalone ./
COPY --from=builder --chown=bun:bun /workspace/frontend/.next/static ./frontend/.next/static
COPY --from=builder --chown=bun:bun /workspace/frontend/public ./frontend/public

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["bun", "frontend/server.js"]
